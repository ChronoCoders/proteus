# MalwareBazaar API Key (Required for malware_collector.py)
MALWAREBAZAAR_API_KEY=your_api_key_here

# Proteus Configuration (Optional - Defaults shown)
PROTEUS_RATE_LIMIT_REQUESTS=10
PROTEUS_RATE_LIMIT_WINDOW=60.0
PROTEUS_TIMEOUT_SECONDS=30
PROTEUS_RETRY_ATTEMPTS=2
PROTEUS_SAMPLES_PER_TAG=50
PROTEUS_MAX_FILE_SIZE_MB=100
PROTEUS_VERBOSE=False

# Cuckoo Sandbox Configuration (Optional)
PROTEUS_CUCKOO_ENABLED=False
PROTEUS_CUCKOO_URL=http://localhost:8090
PROTEUS_CUCKOO_API_TOKEN=your_cuckoo_token_here
PROTEUS_CUCKOO_TIMEOUT=120
PROTEUS_CUCKOO_MAX_WAIT=300
